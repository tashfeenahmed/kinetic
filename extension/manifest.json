{
  "manifest_version": 3,
  "name": "Kinetic Companion",
  "short_name": "Kinetic",
  "description": "Runs your Kinetic automations (LinkedIn, Instagram, X, Facebook) inside your own logged-in browser, at a human pace.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Kinetic Companion", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "tabs", "scripting", "notifications"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.instagram.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.facebook.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://www.instagram.com/*", "https://x.com/*", "https://twitter.com/*", "https://www.facebook.com/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    { "matches": ["https://www.linkedin.com/*"], "js": ["sites/linkedin.js"], "run_at": "document_idle" },
    { "matches": ["https://www.instagram.com/*"], "js": ["sites/instagram.js"], "run_at": "document_idle" },
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["sites/x.js"], "run_at": "document_idle" },
    { "matches": ["https://www.facebook.com/*"], "js": ["sites/facebook.js"], "run_at": "document_idle" }
  ]
}
