# Copy to .env (in the folder you start the server from) and adjust.

# Port and interface the server listens on.
PORT=4200
HOST=127.0.0.1

# Public address of this app. Used in tracking pixels, click links, unsubscribe links
# and the OAuth redirect URI. Must be reachable by recipients for tracking/unsubscribe.
PUBLIC_URL=http://localhost:4200

# Where the SQLite database, encryption key and attachments live. Back this folder up.
DATA_DIR=./data

# Background sending/sync worker. Set to "off" to run the web UI/API only.
WORKERS=on

# Optional: base64 32-byte key for encrypting mailbox passwords. Generated into DATA_DIR/app.key if unset.
# APP_KEY=

LOG_LEVEL=info

# ---- Data, AI & integration keys for Tables (optional) ----
# Every key can also be saved (encrypted) in Settings → Data, AI & integrations; values here win.
# OPENROUTER_API_KEY=
# AI_MODEL=anthropic/claude-haiku-5.5
# AI_BASE_URL=http://localhost:11434/v1     # local Ollama / LM Studio instead of OpenRouter
# SERPER_API_KEY=
# SEARXNG_URL=http://localhost:8888
# GITHUB_TOKEN=
# SEC_USER_AGENT=Your Name you@example.com
# SMTP_HELO=mail.yourdomain.com             # used by the free SMTP email verifier
# SLACK_WEBHOOK_URL=
# HUBSPOT_TOKEN=
